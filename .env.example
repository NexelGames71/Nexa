# Nexa gateway environment configuration.
# Server-only values. NEVER expose these to clients or prefix them with
# frontend-exposed conventions (NEXT_PUBLIC_, VITE_).

NEXA_ENV=development
# Public base URL of this service (used in docs/links, not security).
NEXA_BASE_URL=http://127.0.0.1:8000

# --- Supabase (trusted auth + plan lookup) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Service-role key: SERVER-SIDE ONLY. Used for plan lookup and usage writes.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify JWTs locally with the project JWT secret instead of the
# REST round-trip. If unset, tokens are verified against /auth/v1/user.
SUPABASE_JWT_SECRET=

# --- NVIDIA NIM provider ---
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Fallback used only if a client somehow sends no model (clients normally
# send an explicit id from the catalog).
NVIDIA_DEFAULT_MODEL=stepfun-ai/step-3.7-flash

# --- Model routing ---
# Catalog models pass through to NVIDIA unchanged:
#   stepfun-ai/step-3.7-flash
#   nvidia/nemotron-3-ultra-550b-a55b
#   nvidia/nemotron-3-super-120b-a12b
#   deepseek-ai/deepseek-v4-flash-0731
# Optionally remap any id without touching clients (canary/swaps):
# NEXA_MODEL_ROUTES=deepseek-ai/deepseek-v4-flash-0731=nvidia/nemotron-3-super-120b-a12b

# --- Gateway API keys (optional; static bearer tokens for machine clients) ---
# Comma separated "token:account_id:plan" triples, e.g.
# nxkey_abc123:acct_demo:pro
NEXA_GATEWAY_KEYS=

# --- Limits defaults ---
NEXA_DEFAULT_PLAN=starter

# --- CORS ---
# Comma-separated allowed origins. Development origins are separate from prod.
NEXA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Timeouts ---
NEXA_UPSTREAM_TIMEOUT_SECONDS=120
NEXA_STREAM_IDLE_TIMEOUT_SECONDS=60

# --- Redis (optional; enables shared rate-limit/concurrency state) ---
REDIS_URL=
